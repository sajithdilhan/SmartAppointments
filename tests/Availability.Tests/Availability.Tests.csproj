      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Services\Availability\Availability.Api\Availability.Api.csproj" />
    <ProjectReference Include="..\..\src\Services\Availability\Availability.Application\Availability.Application.csproj" />
    <ProjectReference Include="..\..\src\Services\Availability\Availability.Domain\Availability.Domain.csproj" />
