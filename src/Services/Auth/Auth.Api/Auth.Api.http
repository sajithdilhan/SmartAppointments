@Auth.Api_HostAddress = http://localhost:5008
# An Admin access token from POST /api/auth/login (staff management is admin-only).
@AdminToken = <paste token>
# The id of an active branch from the Availability service.
@BranchId = <paste id>
# The id of a staff user, from the create-staff response.
@StaffId = <paste id>
# The internal API key: InternalApi:Key in appsettings.Development.json (the same value Booking sends).
@InternalApiKey = dev-internal-api-key-3f9a7c1e5b2d4a68-smartappointments

# The Auth service directly (not through the gateway, so no rate limits).

POST {{Auth.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "nimal@example.com",
  "password": "Passw0rd!Passw0rd"
}

###

# A refresh token is single use: the response carries a new accessToken and refreshToken.
# Presenting a token that was already redeemed is 401 and revokes the whole session.
POST {{Auth.Api_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "<paste refreshToken from login>"
}

###

# Idempotent: 204 for any token, known or not.
POST {{Auth.Api_HostAddress}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "<paste refreshToken from login>"
}

###

# ---- Staff accounts (admin only) -------------------------------------------

# 201 with the new staff user. 422 when the branch does not exist or is inactive; 503 when
# Availability is unreachable; 400 for invalid data or an email that is already registered.
POST {{Auth.Api_HostAddress}}/api/auth/staff
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "firstName": "Kamal",
  "lastName": "Perera",
  "email": "kamal.staff@example.com",
  "phoneNumber": "+94771234567",
  "password": "Passw0rd!Passw0rd",
  "branchId": "{{BranchId}}"
}

###

# Moves the staff member to another branch and ends all their refresh-token sessions; access tokens
# already issued keep the old branch until they expire. 404 for an unknown id or a non-staff user.
PUT {{Auth.Api_HostAddress}}/api/auth/staff/{{StaffId}}/branch
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "branchId": "{{BranchId}}"
}

###

# 422: a branch id that does not exist (or is inactive).
PUT {{Auth.Api_HostAddress}}/api/auth/staff/{{StaffId}}/branch
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "branchId": "00000000-0000-7000-8000-00000000dead"
}

###

# A page of staff accounts (deleted ones are never listed), oldest registration first. All four query
# values are optional: branchId, isActive (true or false), page (default 1), pageSize (default 20,
# max 100). 400 lists every bad value at once.
GET {{Auth.Api_HostAddress}}/api/auth/staff?branchId={{BranchId}}&isActive=true&page=1&pageSize=20
Authorization: Bearer {{AdminToken}}

###

# 200 with the staff member, active or not. 404 for an unknown id, a non-staff user or a deleted account.
GET {{Auth.Api_HostAddress}}/api/auth/staff/{{StaffId}}
Authorization: Bearer {{AdminToken}}

###

# 204. Ends all their refresh-token sessions; repeating it is safe and still revokes any live session.
# Access tokens already issued work until they expire. 404 for an unknown, non-staff or deleted user.
POST {{Auth.Api_HostAddress}}/api/auth/staff/{{StaffId}}/deactivate
Authorization: Bearer {{AdminToken}}

###

# 204. Their old sessions stay ended, so they sign in again. 422 when their branch no longer exists or
# is inactive; 503 when Availability is unreachable; 404 for an unknown, non-staff or deleted user.
POST {{Auth.Api_HostAddress}}/api/auth/staff/{{StaffId}}/activate
Authorization: Bearer {{AdminToken}}

###

# 204. Soft delete: ends all sessions, hides the account, keeps its email taken. A second DELETE is 404.
DELETE {{Auth.Api_HostAddress}}/api/auth/staff/{{StaffId}}
Authorization: Bearer {{AdminToken}}

###

# ---- Internal (service-to-service) -----------------------------------------

# Authenticated by X-API-Key only: a bearer token gets 401 here. Unknown ids are omitted from the
# response and duplicates are returned once.
POST {{Auth.Api_HostAddress}}/internal/users/lookup
X-API-Key: {{InternalApiKey}}
Content-Type: application/json

{
  "ids": ["{{StaffId}}"]
}

###
