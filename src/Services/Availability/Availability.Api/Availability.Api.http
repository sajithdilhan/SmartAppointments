@Availability.Api_HostAddress = http://localhost:5202
# An Admin access token from POST /api/Auth/login on the Auth service.
@AdminToken = <paste token>
# The id from the Location header or body of the create response.
@BranchId = <paste id>
# The internal API key: InternalApi:Key in appsettings.Development.json (the same value Booking sends).
@InternalApiKey = dev-internal-api-key-3f9a7c1e5b2d4a68-smartappointments

POST {{Availability.Api_HostAddress}}/api/branches
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "code": "PG",
  "name": "Pettah",
  "description": "Walk-ins welcome before noon",
  "address": "12 Main Street, Colombo",
  "phoneNumber": "+94112345678"
}

###

GET {{Availability.Api_HostAddress}}/api/branches
Authorization: Bearer {{AdminToken}}

###

# Inactive branches are included only for an admin.
GET {{Availability.Api_HostAddress}}/api/branches?includeInactive=true
Authorization: Bearer {{AdminToken}}

###

GET {{Availability.Api_HostAddress}}/api/branches/{{BranchId}}
Authorization: Bearer {{AdminToken}}

###

# The code cannot be changed, so it is not part of the body.
PUT {{Availability.Api_HostAddress}}/api/branches/{{BranchId}}
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "name": "Pettah",
  "description": "Walk-ins welcome all day",
  "address": "14 Main Street, Colombo",
  "phoneNumber": "+94112345678"
}

###

POST {{Availability.Api_HostAddress}}/api/branches/{{BranchId}}/deactivate
Authorization: Bearer {{AdminToken}}

###

POST {{Availability.Api_HostAddress}}/api/branches/{{BranchId}}/activate
Authorization: Bearer {{AdminToken}}

###

# ---- Service types -------------------------------------------------------

@ServiceTypeId = <paste id>

POST {{Availability.Api_HostAddress}}/api/services
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "code": "VEHICLE_INSPECTION",
  "name": "Vehicle inspection",
  "description": "Bring the vehicle logbook",
  "durationMinutes": 30
}

###

GET {{Availability.Api_HostAddress}}/api/services?includeInactive=true
Authorization: Bearer {{AdminToken}}

###

GET {{Availability.Api_HostAddress}}/api/services/{{ServiceTypeId}}
Authorization: Bearer {{AdminToken}}

###

# The code cannot be changed. A new duration applies only to slots generated afterwards.
PUT {{Availability.Api_HostAddress}}/api/services/{{ServiceTypeId}}
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "name": "Vehicle inspection",
  "description": "Bring the vehicle logbook and insurance",
  "durationMinutes": 45
}

###

POST {{Availability.Api_HostAddress}}/api/services/{{ServiceTypeId}}/deactivate
Authorization: Bearer {{AdminToken}}

###

POST {{Availability.Api_HostAddress}}/api/services/{{ServiceTypeId}}/activate
Authorization: Bearer {{AdminToken}}

###

# ---- Schedules and slots -------------------------------------------------

# IANA time zone; days not listed are closed. Replaces the whole weekly schedule.
PUT {{Availability.Api_HostAddress}}/api/branches/{{BranchId}}/schedule
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "timeZoneId": "Asia/Colombo",
  "workingHours": [
    { "dayOfWeek": "Monday", "opensAt": "09:00", "closesAt": "17:00" },
    { "dayOfWeek": "Tuesday", "opensAt": "09:00", "closesAt": "17:00" },
    { "dayOfWeek": "Saturday", "opensAt": "09:00", "closesAt": "12:00" }
  ]
}

###

# Slots last the service type's duration. Re-running a range skips slots that already exist.
POST {{Availability.Api_HostAddress}}/api/slots/generate
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "branchId": "{{BranchId}}",
  "serviceTypeId": "{{ServiceTypeId}}",
  "fromDate": "2026-10-05",
  "toDate": "2026-10-11",
  "capacity": 2
}

###

# Any signed-in role. The date is the branch's local date.
GET {{Availability.Api_HostAddress}}/api/slots/available?branchId={{BranchId}}&serviceId={{ServiceTypeId}}&date=2026-10-05
Authorization: Bearer {{AdminToken}}

###

# ---- Internal (service-to-service) ----------------------------------------

# Authenticated by X-API-Key only: a bearer token gets 401 here, and the key gets 401 on /api/**.
@SlotId = <paste a slot id from the available-slots response>
@AppointmentId = 0198f0a0-0000-7000-8000-000000000001

GET {{Availability.Api_HostAddress}}/internal/slots/{{SlotId}}
X-API-Key: {{InternalApiKey}}

###

# Idempotent per appointment id: repeating it succeeds and takes no second place. 409 when the
# slot is full, has started, or its branch or service type is inactive.
POST {{Availability.Api_HostAddress}}/internal/slots/{{SlotId}}/reserve
X-API-Key: {{InternalApiKey}}
Content-Type: application/json

{
  "appointmentId": "{{AppointmentId}}"
}

###

# Idempotent: releasing a place that is not held also succeeds. No state checks.
POST {{Availability.Api_HostAddress}}/internal/slots/{{SlotId}}/release
X-API-Key: {{InternalApiKey}}
Content-Type: application/json

{
  "appointmentId": "{{AppointmentId}}"
}

###

GET {{Availability.Api_HostAddress}}/healthz

###
