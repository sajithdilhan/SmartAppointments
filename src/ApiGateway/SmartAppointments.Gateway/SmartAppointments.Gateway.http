@Gateway_HostAddress = http://localhost:5290
# Tokens come from the login requests below (the "accessToken" of the response).
@AdminToken = <paste token>
@CustomerToken = <paste token>
@BranchId = <paste id>
@ServiceTypeId = <paste id>
@SlotId = <paste id>
@AppointmentId = <paste id>

# Everything goes through the gateway; the services' own ports are not used here.

# ---- Anonymous routes (rate-limited: the 6th login within a minute from one address is 429) -----

POST {{Gateway_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Nimal",
  "lastName": "Perera",
  "email": "nimal@example.com",
  "phoneNumber": "+94771234567",
  "password": "Passw0rd!Passw0rd"
}

###

POST {{Gateway_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "nimal@example.com",
  "password": "Passw0rd!Passw0rd"
}

###

# Refresh and logout need no Authorization header: the refresh token is the credential.
# A refresh token is single use. The 11th refresh within a minute from one address is 429, and
# replaying a token that was already redeemed is 401 and revokes the whole session (family).
POST {{Gateway_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "<paste refreshToken from login>"
}

###

# Idempotent: 204 for any token, known or not. Access tokens already issued live until they expire.
POST {{Gateway_HostAddress}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "<paste refreshToken from login>"
}

###

# ---- Correlation id ----------------------------------------------------------------------------

# A good value is echoed once on the response; a malformed one (a space, over 64 characters) is replaced.
GET {{Gateway_HostAddress}}/api/branches
Authorization: Bearer {{CustomerToken}}
X-Correlation-ID: e2e-check-001

###

GET {{Gateway_HostAddress}}/api/branches
Authorization: Bearer {{CustomerToken}}
X-Correlation-ID: bad value!

###

# ---- Branches, service types, slots (Admin writes; any signed-in role reads) ---------------------

POST {{Gateway_HostAddress}}/api/branches
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "code": "PG",
  "name": "Pettah",
  "description": "Walk-ins welcome before noon",
  "address": "12 Main Street, Colombo",
  "phoneNumber": "+94112345678"
}

###

PUT {{Gateway_HostAddress}}/api/branches/{{BranchId}}/schedule
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "timeZoneId": "Asia/Colombo",
  "workingHours": [
    { "dayOfWeek": "Monday", "opensAt": "09:00", "closesAt": "17:00" },
    { "dayOfWeek": "Tuesday", "opensAt": "09:00", "closesAt": "17:00" },
    { "dayOfWeek": "Saturday", "opensAt": "09:00", "closesAt": "12:00" }
  ]
}

###

POST {{Gateway_HostAddress}}/api/services
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "code": "VEHICLE_INSPECTION",
  "name": "Vehicle inspection",
  "description": "Bring the vehicle logbook",
  "durationMinutes": 30
}

###

POST {{Gateway_HostAddress}}/api/slots/generate
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "branchId": "{{BranchId}}",
  "serviceTypeId": "{{ServiceTypeId}}",
  "fromDate": "2026-10-05",
  "toDate": "2026-10-11",
  "capacity": 2
}

###

# Rate-limited per user: the 31st search within a minute is 429.
GET {{Gateway_HostAddress}}/api/slots/available?branchId={{BranchId}}&serviceId={{ServiceTypeId}}&date=2026-10-05
Authorization: Bearer {{CustomerToken}}

###

# A customer on an admin-only route: the 403 is the service's, passed through.
POST {{Gateway_HostAddress}}/api/branches
Authorization: Bearer {{CustomerToken}}
Content-Type: application/json

{
  "code": "XX",
  "name": "Nope",
  "description": "",
  "address": "-",
  "phoneNumber": "+94112345678"
}

###

# ---- Appointments (rate-limited per user: the 11th create within a minute is 429; use a new key each time) ----

POST {{Gateway_HostAddress}}/api/appointments
Authorization: Bearer {{CustomerToken}}
Idempotency-Key: 6d1c7a52-0b1f-4f3c-9a43-2f7d6a3e8c10
Content-Type: application/json

{
  "slotId": "{{SlotId}}"
}

###

GET {{Gateway_HostAddress}}/api/appointments/{{AppointmentId}}
Authorization: Bearer {{CustomerToken}}

###

POST {{Gateway_HostAddress}}/api/appointments/{{AppointmentId}}/cancel
Authorization: Bearer {{CustomerToken}}

###

# Customers only; filters status (Booked, Cancelled), when (upcoming, past), page, pageSize. Not rate limited.
GET {{Gateway_HostAddress}}/api/appointments/my?status=Booked&when=upcoming
Authorization: Bearer {{CustomerToken}}

###

# ---- Edge authentication: the gateway answers 401 with WWW-Authenticate: Bearer, no service is called ----

GET {{Gateway_HostAddress}}/api/branches

###

GET {{Gateway_HostAddress}}/api/branches
Authorization: Bearer {{CustomerToken}}tampered

###

# ---- Not routed: 404 from the gateway, no token needed -------------------------------------------

GET {{Gateway_HostAddress}}/internal/slots/{{SlotId}}

###

GET {{Gateway_HostAddress}}/openapi/v1.json

###

GET {{Gateway_HostAddress}}/api/queue/x

###

# ---- Aggregated health: 200 Healthy; 200 Degraded naming a service that is down (answers in ~2 s) ----

GET {{Gateway_HostAddress}}/healthz

###

# ---- Development only: aggregated API docs (anonymous). /scalar is the UI; each document's servers is the gateway ----

GET {{Gateway_HostAddress}}/scalar/

###

GET {{Gateway_HostAddress}}/openapi/auth/v1.json

###

GET {{Gateway_HostAddress}}/openapi/availability/v1.json

###

GET {{Gateway_HostAddress}}/openapi/booking/v1.json

###

# ---- CORS (Cors:AllowedOrigins; Development allows http://localhost:4200 and http://localhost:8081) ----
# A preflight from an allowed origin is answered by the gateway with 204 before authentication, rate limits and
# routing, so no token is needed and no service is called (check Availability's log for the /internal/ one).
# Every answer carries X-Correlation-ID.

@WebOrigin = http://localhost:4200

# Expected: 204; Access-Control-Allow-Origin = the origin, Allow-Methods GET,POST,PUT,DELETE,
# Allow-Headers Authorization,Content-Type,Idempotency-Key,X-Correlation-ID, Max-Age 600, Vary: Origin;
# no Access-Control-Allow-Credentials.
OPTIONS {{Gateway_HostAddress}}/api/appointments
Origin: {{WebOrigin}}
Access-Control-Request-Method: POST
Access-Control-Request-Headers: authorization,idempotency-key,content-type

###

# Expected: 204 with the same headers (an anonymous route).
OPTIONS {{Gateway_HostAddress}}/api/auth/login
Origin: {{WebOrigin}}
Access-Control-Request-Method: POST
Access-Control-Request-Headers: content-type

###

# Expected: 204, not 404 (a path that is not routed).
OPTIONS {{Gateway_HostAddress}}/nothing
Origin: {{WebOrigin}}
Access-Control-Request-Method: GET

###

# Expected: 204, not 404, and nothing in Availability's log (/internal/** is never routed).
OPTIONS {{Gateway_HostAddress}}/internal/slots/{{SlotId}}
Origin: {{WebOrigin}}
Access-Control-Request-Method: POST

###

# Expected: 204 whose Allow-Methods lacks PATCH; the browser would block the real request.
OPTIONS {{Gateway_HostAddress}}/api/appointments/{{AppointmentId}}
Origin: {{WebOrigin}}
Access-Control-Request-Method: PATCH

###

# Expected: 204 whose Allow-Headers lacks x-evil.
OPTIONS {{Gateway_HostAddress}}/api/appointments
Origin: {{WebOrigin}}
Access-Control-Request-Method: POST
Access-Control-Request-Headers: x-evil

###

# Expected: 204 with no Access-Control-* header and no Vary (origin not allowed).
OPTIONS {{Gateway_HostAddress}}/api/appointments
Origin: https://evil.example
Access-Control-Request-Method: POST

###

# Expected: 204 with no Access-Control-* header (the null origin is never allowed).
OPTIONS {{Gateway_HostAddress}}/api/appointments
Origin: null
Access-Control-Request-Method: POST

###

# Expected: 401 (not a preflight: no Access-Control-Request-Method), with Allow-Origin.
OPTIONS {{Gateway_HostAddress}}/api/appointments
Origin: {{WebOrigin}}

###

# Expected: 401 with Allow-Origin, Expose-Headers (X-Correlation-ID,Retry-After,Location) and Vary: Origin.
GET {{Gateway_HostAddress}}/api/branches
Origin: {{WebOrigin}}

###

# Expected: 404 with Allow-Origin.
GET {{Gateway_HostAddress}}/api/queue/x
Origin: {{WebOrigin}}

###

# Expected: 200 with Allow-Origin, Expose-Headers and the unchanged body.
GET {{Gateway_HostAddress}}/api/branches
Origin: {{WebOrigin}}
Authorization: Bearer {{CustomerToken}}

###

# Expected: 200 with Allow-Origin and the unchanged body.
GET {{Gateway_HostAddress}}/healthz
Origin: {{WebOrigin}}

###

# Expected: 200 and no Access-Control-* header (origin not allowed, nothing rejected).
GET {{Gateway_HostAddress}}/api/branches
Origin: https://evil.example
Authorization: Bearer {{CustomerToken}}

###

# Expected with Booking stopped: 502 (problem+json) with Allow-Origin.
GET {{Gateway_HostAddress}}/api/appointments/{{AppointmentId}}
Origin: {{WebOrigin}}
Authorization: Bearer {{CustomerToken}}

###

# Rate limit: send this six times within a minute. Expected: the 6th is 429 with Allow-Origin and Retry-After.
# Ten preflights to /api/auth/login beforehand leave all five attempts available (a preflight costs no permit).
POST {{Gateway_HostAddress}}/api/auth/login
Origin: {{WebOrigin}}
Content-Type: application/json

{
  "email": "nobody@example.com",
  "password": "wrong"
}

###
